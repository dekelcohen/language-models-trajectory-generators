<?xml version="1.0"?>
<!-- USB-A plug: plastic housing (gripped) + metal tip (inserted). Tip points +x.
     Real USB-A: tip 12.0 x 4.5 mm, ~12 mm long; housing ~16 x 8 mm. Link origin = housing centre. -->
<robot name="usb_plug">
  <link name="plug">
    <inertial>
      <origin xyz="0.003 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="4e-7" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1.2e-6"/>
    </inertial>
    <visual name="housing">
      <geometry><box size="0.025 0.016 0.008"/></geometry>
      <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision name="housing">
      <geometry><box size="0.025 0.016 0.008"/></geometry>
    </collision>
    <visual name="tip">
      <origin xyz="0.0185 0 0"/>
      <geometry><box size="0.012 0.012 0.0045"/></geometry>
      <material name="metal"><color rgba="0.75 0.75 0.78 1"/></material>
    </visual>
    <collision name="tip">
      <origin xyz="0.0185 0 0"/>
      <geometry><box size="0.012 0.012 0.0045"/></geometry>
    </collision>
  </link>
</robot>
