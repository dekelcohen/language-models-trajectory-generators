import math

# Reusable helpers
def unit_from_angle(theta):
    """
    Return a 2D unit vector [ux, uy] from an angle theta (radians) in the XY plane.
    """
    return [math.cos(theta), math.sin(theta)]

def exec_linear_step(desc, start_pose, end_pose, num_points=8):
    """
    Generate and execute a straight-line trajectory between start_pose and end_pose.
    Each pose is [x, y, z, theta]. Keep num_points >= 5 for contact-rich steps.
    """
    trajectory = generate_linear_trajectory(desc=desc, start_pose=start_pose, end_pose=end_pose, num_points=num_points)
    execute_trajectory(trajectory)
    return end_pose

def compute_arc_targets(center_xy, start_xy, total_delta_angle, segments):
    """
    Compute successive arc endpoint XYs around center_xy starting from start_xy,
    rotating the radius vector in steps of total_delta_angle/segments.
    Returns a list of [x, y, phi_i] and the initial angle phi0, radius, and dphi.
    """
    cx, cy = center_xy
    sx, sy = start_xy
    rx = sx - cx
    ry = sy - cy
    r = math.hypot(rx, ry)
    phi0 = math.atan2(ry, rx)
    dphi = total_delta_angle / segments
    targets = []
    for i in range(1, segments + 1):
        phi_i = phi0 + i * dphi
        x_i = cx + r * math.cos(phi_i)
        y_i = cy + r * math.sin(phi_i)
        targets.append([x_i, y_i, phi_i])
    return targets, phi0, r, dphi

