import math

# Helper functions
def unit_from_angle(theta):
    """
    Return a 2D unit vector [ux, uy] from an angle theta (radians) in the XY plane.
    """
    return [math.cos(theta), math.sin(theta)]

def compute_arc_targets(center_xy, start_xy, total_delta_angle, segments):
    """
    Compute successive arc endpoint XYs around center_xy starting from start_xy.
    Returns: targets = list of [x, y, phi_i]; phi0 = initial polar angle; radius; dphi.
    """
    cx, cy = center_xy
    sx, sy = start_xy
    rx, ry = sx - cx, sy - cy
    r = math.hypot(rx, ry)
    phi0 = math.atan2(ry, rx)
    dphi = total_delta_angle / segments
    targets = []
    for i in range(1, segments + 1):
        phi_i = phi0 + i * dphi
        x_i = cx + r * math.cos(phi_i)
        y_i = cy + r * math.sin(phi_i)
        targets.append([x_i, y_i, phi_i])
    return targets, phi0, r, dphi

# Known environment state (given)
ee_start = [-0.4250813562749804, 0.16881665456652103, 0.7267260329858313, 0.0]  # current EE pose; gripper open
handle_pos = [-0.326, -0.049, 0.638]
handle_angle_long = 0.926
handle_angle_short = -0.645
hinge_xy = [-0.229, -0.001]   # hinge center in XY
door_plate_pos = [0.093, 0.039, 0.658]

# Heights (safe approach and articulation)
hover_z = handle_pos[2] + 0.150   # high hover for safety
z_pre_contact = handle_pos[2] + 0.011
z_grasp = handle_pos[2] + 0.000
z_press = z_grasp - 0.010         # 10 mm downward press to unlatch
z_pull = z_grasp + 0.008          # +8 mm elevation during pull for clearance

# Insertion offset and centering at hover height
short_axis_uv = unit_from_angle(handle_angle_short)
long_axis_uv = unit_from_angle(handle_angle_long)
offset_short = 0.018               # 18 mm target along short-axis toward the door plate
to_plate_vec = [door_plate_pos[0] - handle_pos[0], door_plate_pos[1] - handle_pos[1]]
sign_dir = 1.0 if (short_axis_uv[0] * to_plate_vec[0] + short_axis_uv[1] * to_plate_vec[1]) >= 0.0 else -1.0
offset_xy = [sign_dir * offset_short * short_axis_uv[0], sign_dir * offset_short * short_axis_uv[1]]

nudge_long = 0.003                 # 3 mm micro nudge along long-axis to refine centering
nudge_xy = [nudge_long * long_axis_uv[0], nudge_long * long_axis_uv[1]]

align_xy = [handle_pos[0] + offset_xy[0], handle_pos[1] + offset_xy[1]]
align_nudged_xy = [align_xy[0] + nudge_xy[0], align_xy[1] + nudge_xy[1]]

# Arc parameters for door opening (extended for full open, smooth)
arc_total = 2.25                   # ~129 degrees
arc_segments = 16
arc_targets, phi0, radius, dphi = compute_arc_targets(center_xy=hinge_xy,
                                                      start_xy=align_nudged_xy,
                                                      total_delta_angle=arc_total,
                                                      segments=arc_segments)

# Outward short-axis clearance nudge (away from door plate) applied after relieving press
clearance_nudge = 0.004            # 4 mm outward
outward_xy = [-sign_dir * clearance_nudge * short_axis_uv[0], -sign_dir * clearance_nudge * short_axis_uv[1]]

# Print key scalars for traceability (3 decimals). Avoid printing trajectory points.
print(f"hover_z: {hover_z:.3f}")
print(f"z_pre_contact: {z_pre_contact:.3f}")
print(f"z_grasp: {z_grasp:.3f}")
print(f"z_press: {z_press:.3f}")
print(f"z_pull: {z_pull:.3f}")
print(f"offset_xy: [{offset_xy[0]:.3f}, {offset_xy[1]:.3f}]")
print(f"align_xy: [{align_xy[0]:.3f}, {align_xy[1]:.3f}]")
print(f"align_nudged_xy: [{align_nudged_xy[0]:.3f}, {align_nudged_xy[1]:.3f}]")
print(f"arc_radius: {radius:.3f}")
print(f"arc_phi0: {phi0:.3f}")
print(f"arc_dphi: {dphi:.3f}")
print(f"arc_total: {arc_total:.3f}")
print(f"arc_segments: {arc_segments:.3f}")
print(f"outward_nudge_xy: [{outward_xy[0]:.3f}, {outward_xy[1]:.3f}]")

# 1) High hover above lever center, orient to angle_long
trajectory_1 = generate_linear_trajectory(
    desc="Step 1: High hover above lever center, orient gripper to angle_long",
    start_pose=ee_start,
    end_pose=[handle_pos[0], handle_pos[1], hover_z, handle_angle_long],
    num_points=8
)
execute_trajectory(trajectory_1)

# 2) Lateral alignment at hover height to bias inboard jaw into door gap
trajectory_2 = generate_linear_trajectory(
    desc="Step 2: Lateral alignment at hover height (short-axis toward door gap)",
    start_pose=trajectory_1.points[-1],
    end_pose=[align_xy[0], align_xy[1], hover_z, handle_angle_long],
    num_points=6
)
execute_trajectory(trajectory_2)

# 3) Micro long-axis nudge at hover to refine centering
trajectory_3 = generate_linear_trajectory(
    desc="Step 3: Micro long-axis nudge at hover to refine centering",
    start_pose=trajectory_2.points[-1],
    end_pose=[align_nudged_xy[0], align_nudged_xy[1], hover_z, handle_angle_long],
    num_points=5
)
execute_trajectory(trajectory_3)

# 4) Vertical descent to pre-contact above lever
trajectory_4 = generate_linear_trajectory(
    desc="Step 4: Vertical descent to pre-contact above lever",
    start_pose=trajectory_3.points[-1],
    end_pose=[align_nudged_xy[0], align_nudged_xy[1], z_pre_contact, handle_angle_long],
    num_points=6
)
execute_trajectory(trajectory_4)

# 5) Final descent to grasp height at lever thickness
trajectory_5 = generate_linear_trajectory(
    desc="Step 5: Final descent to grasp height at lever thickness",
    start_pose=trajectory_4.points[-1],
    end_pose=[align_nudged_xy[0], align_nudged_xy[1], z_grasp, handle_angle_long],
    num_points=5
)
execute_trajectory(trajectory_5)
close_gripper()

# 6) Small downward press to unlatch
trajectory_6 = generate_linear_trajectory(
    desc="Step 6: Small downward press to unlatch",
    start_pose=trajectory_5.points[-1],
    end_pose=[align_nudged_xy[0], align_nudged_xy[1], z_press, handle_angle_long],
    num_points=5
)
execute_trajectory(trajectory_6)

# 7–9) Arc pull segments 1–3 at press height (maintain press), adaptive rotation
curr_pose = trajectory_6.points[-1]
for seg_idx in range(3):
    x_i, y_i, phi_i = arc_targets[seg_idx]
    rot_i = handle_angle_long + (phi_i - phi0)  # adaptive orientation following hinge arc
    end_pose = [x_i, y_i, z_press, rot_i]
    trajectory_num = 7 + seg_idx
    globals()[f"trajectory_{trajectory_num}"] = generate_linear_trajectory(
        desc=f"Step {trajectory_num:02d}: Arc pull segment {seg_idx+1} (maintain press)",
        start_pose=curr_pose,
        end_pose=end_pose,
        num_points=6
    )
    execute_trajectory(globals()[f"trajectory_{trajectory_num}"])
    curr_pose = end_pose

# 10) Relieve press to slight elevation (z_pull) for clearance
trajectory_10 = generate_linear_trajectory(
    desc="Step 10: Relieve press to slight elevation for clearance",
    start_pose=curr_pose,
    end_pose=[curr_pose[0], curr_pose[1], z_pull, curr_pose[3]],
    num_points=5
)
execute_trajectory(trajectory_10)
curr_pose = trajectory_10.points[-1]

# 11) Outward short-axis clearance nudge away from door plate at z_pull
trajectory_11 = generate_linear_trajectory(
    desc="Step 11: Outward short-axis clearance nudge away from door plate",
    start_pose=curr_pose,
    end_pose=[curr_pose[0] + outward_xy[0], curr_pose[1] + outward_xy[1], z_pull, curr_pose[3]],
    num_points=5
)
execute_trajectory(trajectory_11)
curr_pose = trajectory_11.points[-1]

# 12–27) Continue arc segments 4–16 at z_pull with adaptive rotation
for seg_idx in range(3, arc_segments):
    x_i, y_i, phi_i = arc_targets[seg_idx]
    rot_i = handle_angle_long + (phi_i - phi0)
    end_pose = [x_i, y_i, z_pull, rot_i]
    trajectory_num = 12 + (seg_idx - 3)
    globals()[f"trajectory_{trajectory_num}"] = generate_linear_trajectory(
        desc=f"Step {trajectory_num:02d}: Arc pull segment {seg_idx+1}",
        start_pose=curr_pose,
        end_pose=end_pose,
        num_points=6
    )
    execute_trajectory(globals()[f"trajectory_{trajectory_num}"])
    curr_pose = end_pose

# 28) Retreat upward to safe hover at final XY
trajectory_28 = generate_linear_trajectory(
    desc="Step 28: Retreat upward to safe hover",
    start_pose=curr_pose,
    end_pose=[curr_pose[0], curr_pose[1], hover_z, curr_pose[3]],
    num_points=6
)
execute_trajectory(trajectory_28)

# Release lever and mark task complete
open_gripper()
task_completed()

