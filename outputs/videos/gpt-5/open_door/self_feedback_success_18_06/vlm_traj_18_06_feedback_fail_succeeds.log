- Collision avoidance: All XY motion is performed at a safe hover height above the lever. Descent is strictly vertical. We will press slightly downward after closing to unlatch before executing the pull.
- Pull direction: We compute the vector from hinge to handle and use its in-plane perpendicular as a tangent pull direction. We choose the sign that increases +y (toward the robot), which is a reasonable “pull toward you” direction to swing the door open.

Detailed step-by-step plan:
1) High hover approach over lever center.
2) Lateral alignment at hover height to an inboard XY offset along the short-axis toward the door.
3) Descend to just above the lever top surface.
4) Descend to grasp height at lever mid-thickness; close the gripper.
5) Apply a small additional downward press to unlatch.
6) Pull along the computed tangent direction a large distance to open the door.
7) Relieve downward press by returning to grasp height; open gripper.
8) Retreat vertically to a safe hover height.
Each trajectory is linear and chained so that the end of step i is the start of step i+1.

```python
import math

# ----------------------------
# Known perception from detect_object (single instance chosen)
# ----------------------------
handle_pos = [-0.326, -0.049, 0.638]
handle_dims = {"width": 0.046, "length": 0.016, "height": 0.003}
angle_short = -0.645   # closing direction to keep fingers parallel to long axis
angle_long  =  0.926

door_pos   = [0.093, 0.039, 0.658]
hinge_pos  = [-0.229, -0.001, 0.669]

# ----------------------------
# Current robot state (given)
# ----------------------------
current_pose = [-0.3887993829569245, 0.6538050429520935, 0.9597697721155961, 0.0]

# ----------------------------
# Helper functions
# ----------------------------
def move_and_execute(desc, start_pose, end_pose, num_points=20):
    """
    Create and execute a straight-line end-effector trajectory.
    Poses are [x, y, z, theta]. Returns end_pose for chaining.
    """
    traj = generate_linear_trajectory(desc, start_pose, end_pose, num_points=num_points)
    execute_trajectory(traj)
    return end_pose

def make_pose(x, y, z, theta):
    """Utility to build a 4D pose list."""
    return [float(x), float(y), float(z), float(theta)]

def unit_from_angle(theta):
    """2D unit vector [cos(theta), sin(theta)]."""
    return [math.cos(theta), math.sin(theta)]

def normalize(vec2):
    """Normalize a 2D vector."""
    lx = math.hypot(vec2[0], vec2[1])
    if lx < 1e-6:
        return [0.0, 0.0]
    return [vec2[0]/lx, vec2[1]/lx]

# ----------------------------
# Derive key geometric quantities
# ----------------------------
hx, hy, hz = handle_pos
door_xy = [door_pos[0] - hx, door_pos[1] - hy]       # vector from handle to door plate center (for "toward door" test)
top_z = hz + handle_dims["height"] / 2.0

# Hover/approach heights (conservative clearances)
hover_clearance = 0.150
pre_contact_clearance = 0.010
hover_z = top_z + hover_clearance
z_pre_contact = top_z + pre_contact_clearance
z_grasp = hz                             # at lever mid-thickness
z_press = z_grasp - 0.015                # small downward press to unlatch (1.5 cm)

# Orientation for grasp: align closing direction to short-axis so fingers are parallel to long axis
grip_theta = angle_short

# Short-axis unit vector (for inboard offset toward door)
s_dir = unit_from_angle(angle_short)
# If not pointing toward door plate center, flip sign
dot_to_door = s_dir[0]*door_xy[0] + s_dir[1]*door_xy[1]
if dot_to_door < 0:
    s_dir = [-s_dir[0], -s_dir[1]]

# Choose a small inboard offset so one jaw drops into the gap as we descend
offset_short = 0.012  # 12 mm
offset_xy = [hx + s_dir[0]*offset_short, hy + s_dir[1]*offset_short]

# Pull direction: tangent to arc about hinge = perpendicular to radius (hinge->handle) in XY
p = [hx - hinge_pos[0], hy - hinge_pos[1]]   # radius
t1 = [-p[1], p[0]]                            # one perpendicular
t2 = [-t1[0], -t1[1]]                         # opposite sign
# Prefer pulling toward +y (toward the robot)
t_candidate = t1 if (t1[1] > t2[1]) else t2
t_dir = normalize(t_candidate)

pull_distance = 0.25  # 25 cm pull to open the door
pull_xy = [offset_xy[0] + t_dir[0]*pull_distance,
           offset_xy[1] + t_dir[1]*pull_distance]

# Print a few derived values for traceability (3 decimals as requested)
print(f"grip_theta(rad): {grip_theta:.3f}")
print(f"hover_z: {hover_z:.3f}")
print(f"z_pre_contact: {z_pre_contact:.3f}")
print(f"z_grasp: {z_grasp:.3f}, z_press: {z_press:.3f}")
print(f"short_axis_unit: [{s_dir[0]:.3f}, {s_dir[1]:.3f}]  offset_short(m): {offset_short:.3f}")
print(f"offset_xy: [{offset_xy[0]:.3f}, {offset_xy[1]:.3f}]")
print(f"tangent_dir: [{t_dir[0]:.3f}, {t_dir[1]:.3f}]  pull_distance(m): {pull_distance:.3f}")
print(f"pull_xy: [{pull_xy[0]:.3f}, {pull_xy[1]:.3f}]")

# ----------------------------
# Step-by-Step Trajectory Execution
# ----------------------------

# Ensure gripper is open before approaching
open_gripper()

# Step 1: High hover over lever midpoint
hover_center_pose = make_pose(hx, hy, hover_z, grip_theta)
trajectory_1 = generate_linear_trajectory("Step 1: move to high hover above lever center", current_pose, hover_center_pose, num_points=20)
execute_trajectory(trajectory_1)
current_pose = hover_center_pose

# Step 2: Lateral alignment at hover height to inboard offset along short-axis
hover_offset_pose = make_pose(offset_xy[0], offset_xy[1], hover_z, grip_theta)
trajectory_2 = generate_linear_trajectory("Step 2: lateral align at hover to inboard offset", current_pose, hover_offset_pose, num_points=20)
execute_trajectory(trajectory_2)
current_pose = hover_offset_pose

# Step 3: Descend to pre-contact height just above lever top
pre_contact_pose = make_pose(offset_xy[0], offset_xy[1], z_pre_contact, grip_theta)
trajectory_3 = generate_linear_trajectory("Step 3: descend to pre-contact above lever", current_pose, pre_contact_pose, num_points=20)
execute_trajectory(trajectory_3)
current_pose = pre_contact_pose

# Step 4: Descend to grasp height at lever mid-thickness
grasp_pose = make_pose(offset_xy[0], offset_xy[1], z_grasp, grip_theta)
trajectory_4 = generate_linear_trajectory("Step 4: descend to grasp height", current_pose, grasp_pose, num_points=20)
execute_trajectory(trajectory_4)
current_pose = grasp_pose

# Close gripper to grasp lever thickness (short side = 0.016m < 0.08m spec)
close_gripper()

# Step 5: Apply small downward press to unlatch
press_pose = make_pose(offset_xy[0], offset_xy[1], z_press, grip_theta)
trajectory_5 = generate_linear_trajectory("Step 5: small downward press to unlatch", current_pose, press_pose, num_points=10)
execute_trajectory(trajectory_5)
current_pose = press_pose

# Step 6: Pull along tangent direction to swing door open
pull_pose = make_pose(pull_xy[0], pull_xy[1], z_press, grip_theta)
trajectory_6 = generate_linear_trajectory("Step 6: pull along tangent direction to open the door", current_pose, pull_pose, num_points=25)
execute_trajectory(trajectory_6)
current_pose = pull_pose

# Step 7: Relieve press (raise slightly to grasp height), then release
relieve_pose = make_pose(pull_xy[0], pull_xy[1], z_grasp, grip_theta)
trajectory_7 = generate_linear_trajectory("Step 7: relieve downward press", current_pose, relieve_pose, num_points=10)
execute_trajectory(trajectory_7)
current_pose = relieve_pose

open_gripper()

# Step 8: Retreat vertically to safe hover
retreat_hover_pose = make_pose(pull_xy[0], pull_xy[1], hover_z, grip_theta)
trajectory_8 = generate_linear_trajectory("Step 8: retreat to safe hover", current_pose, retreat_hover_pose, num_points=20)
execute_trajectory(trajectory_8)
current_pose = retreat_hover_pose

# Finish
task_completed()

