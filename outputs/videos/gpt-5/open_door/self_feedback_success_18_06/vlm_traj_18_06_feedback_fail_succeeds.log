    """
    Compute successive arc endpoint XYs around center_xy starting from start_xy,
    by rotating the radius vector in steps of total_delta_angle/segments.
    Returns a list of target XY points [x, y] for each segment.
    """
    cx, cy = center_xy
    sx, sy = start_xy
    rx = sx - cx
    ry = sy - cy
    r = math.hypot(rx, ry)
    phi0 = math.atan2(ry, rx)
    dphi = total_delta_angle / segments
    targets = []
    for i in range(1, segments + 1):
