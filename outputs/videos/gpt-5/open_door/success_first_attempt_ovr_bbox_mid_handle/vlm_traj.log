# Utilities and parameters for the door-handle opening task
from math import cos, sin, sqrt, pi

# Scene data from perception (copied for clarity)
door_pos = [0.089, 0.038, 0.658]
door_angle_long = -1.402

lever_pos = [-0.241, 0.053, 0.667]
lever_dims = {"width": 0.084, "length": 0.018, "height": 0.034}  # long ~ 0.084 (lever), short/thickness ~ 0.018
lever_angle_short = -0.692  # along lever thickness
lever_angle_long = 0.878    # along lever length (visual long axis)

# Current robot state (given)
current_pose = [-0.3887993829569245, 0.6538050429520935, 0.9597697721155961, 0.0]

# Derived grasp/orientation settings
# To keep the fingers parallel to the lever’s long axis, the closing-motion (rotation) aligns with the short axis.
grip_theta = lever_angle_short  # -0.692 rad
print(f"Chosen rotation (rad): {grip_theta:.3f}")

# Heights
lever_center_z = lever_pos[2]
lever_top_z = lever_center_z + lever_dims["height"] / 2.0
z_high = lever_top_z + 0.20           # high hover ~20 cm above the top of the lever
z_approach = lever_top_z + 0.05       # ~5 cm above top before final descent
z_preclose = lever_center_z + 0.010   # just above center before final close
z_grasp = lever_center_z              # grasp at the lever mid-height
z_unlatch = lever_center_z - 0.015    # push down ~1.5 cm to unlatch
print(f"z_high: {z_high:.3f}, z_approach: {z_approach:.3f}, z_preclose: {z_preclose:.3f}, z_grasp: {z_grasp:.3f}, z_unlatch: {z_unlatch:.3f}")

# Horizontal offset along lever short-axis toward the door
sx, sy = cos(lever_angle_short), sin(lever_angle_short)  # short-axis direction (in XY)
door_vec = [door_pos[0] - lever_pos[0], door_pos[1] - lever_pos[1]]
door_vec_len = max(1e-6, sqrt(door_vec[0]**2 + door_vec[1]**2))
door_dir = [door_vec[0] / door_vec_len, door_vec[1] / door_vec_len]

# Determine sign so the offset goes "toward the door"
sign_toward_door = 1.0 if (sx * door_dir[0] + sy * door_dir[1]) >= 0.0 else -1.0
offset_mag = 0.010  # 1 cm
offset_xy = [sign_toward_door * offset_mag * sx, sign_toward_door * offset_mag * sy]
print(f"Offset toward door (m): dx={offset_xy[0]:.3f}, dy={offset_xy[1]:.3f}")

