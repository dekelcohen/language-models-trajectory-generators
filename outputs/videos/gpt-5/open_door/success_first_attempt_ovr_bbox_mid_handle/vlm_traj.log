print(f"Pull dir: ux={pull_dir[0]:.3f}, uy={pull_dir[1]:.3f}, L={pull_distance:.3f}")

# Helper for linear motion
def move_linear(desc: str, start_pose: list, end_pose: list, num_points: int = 10):
