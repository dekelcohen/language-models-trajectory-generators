trajectory_2 = generate_linear_trajectory(
    "T2: lateral offset at hover for jaw insertion toward door",
    hover_center_pose,
    hover_offset_pose,
    num_points=8
)
execute_trajectory(trajectory_2)

# ---------------------------
# Prepare gripper and descend
# ---------------------------
open_gripper()

# ---------------------------
# Step T3: Descend to approach height above handle
# ---------------------------
approach_pose = make_pose(hover_offset_pose[0], hover_offset_pose[1], approach_z, grip_theta)

trajectory_3 = generate_linear_trajectory(
    "T3: descend to approach height above handle",
    hover_offset_pose,
    approach_pose,
    num_points=8
)
execute_trajectory(trajectory_3)

# ---------------------------
# Step T4: Descend to grasp height (lever mid)
# ---------------------------
grasp_pose = make_pose(hover_offset_pose[0], hover_offset_pose[1], grasp_z, grip_theta)

trajectory_4 = generate_linear_trajectory(
    "T4: descend to lever grasp height",
    approach_pose,
    grasp_pose,
    num_points=8
)
execute_trajectory(trajectory_4)

# Close to grasp lever thickness
close_gripper()

# ---------------------------
# Step T5: Apply small downward press to unlatch
