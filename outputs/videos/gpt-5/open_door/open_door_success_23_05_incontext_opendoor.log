import math

# ---------------------------
# Known perception inputs
# ---------------------------
handle_x, handle_y, handle_z = -0.319, -0.127, 0.638
handle_width, handle_length, handle_height = 0.185, 0.032, 0.074
angle_short, angle_long = -0.03, 1.541

door_x, door_y, door_z = -0.196, -0.13, 0.894

# Current end-effector state (from environment setup)
ee_x, ee_y, ee_z, ee_theta = -0.3887993829569245, 0.6538050429520935, 0.9597697721155961, 0.0

# ---------------------------
# Helper functions
# ---------------------------
def make_pose(x: float, y: float, z: float, theta: float):
    """
    Create a 4D end-effector pose [x, y, z, theta].
    theta is the orientation of the gripper closing direction (radians).
    """
    return [x, y, z, theta]

def compute_short_axis_offset_toward_door(angle_short: float,
                                          handle_pos: tuple,
                                          door_pos: tuple,
                                          thickness: float,
                                          margin: float = 0.005):
    """
    Compute a small horizontal offset from the handle center along its short-axis direction,
    choosing the sign so the offset points toward the door (to let one jaw slide into the gap).
    Returns (offset_x, offset_y, signed_distance).

    angle_short: orientation (radians) of the lever's short axis (thickness/closing direction)
    handle_pos: (x,y,z)
    door_pos: (x,y,z)
    thickness: thickness to grasp (short side length)
    margin: safety margin so the jaw does not collide with the backplate
    """
    # Desired magnitude: half thickness minus margin, clamped to [3mm, 20mm] for safety
    half_minus_margin = max(0.003, min(thickness * 0.5 - margin, 0.02))

    # Unit vector along short axis in XY
    sx, sy = math.cos(angle_short), math.sin(angle_short)

    # Direction from handle to door in XY (unit)
    dx, dy = door_pos[0] - handle_pos[0], door_pos[1] - handle_pos[1]
    dnorm = math.hypot(dx, dy) if math.hypot(dx, dy) > 1e-6 else 1.0
    ux, uy = dx / dnorm, dy / dnorm

    # Choose sign so the offset points toward the door
    sign = 1.0 if (sx * ux + sy * uy) >= 0.0 else -1.0
    signed_distance = sign * half_minus_margin

    # Offset components
    off_x = sx * signed_distance
    off_y = sy * signed_distance
    return off_x, off_y, signed_distance

# ---------------------------
# Derived geometric quantities
# ---------------------------
top_z = handle_z + handle_height * 0.5
hover_clearance = 0.15
approach_clearance = 0.02

hover_z = top_z + hover_clearance
approach_z = top_z + approach_clearance
grasp_z = handle_z  # around lever mid-height

# Print a few computed scalars (3 decimals) for traceability
print(f"top_z: {top_z:.3f}")
print(f"hover_z: {hover_z:.3f}")
print(f"approach_z: {approach_z:.3f}")
print(f"grasp_z: {grasp_z:.3f}")

# Compute insertion offset along short axis toward the door
offset_x, offset_y, signed_offset = compute_short_axis_offset_toward_door(
    angle_short,
    (handle_x, handle_y, handle_z),
    (door_x, door_y, door_z),
    thickness=handle_length,
    margin=0.005
)

print(f"insertion_offset_signed: {signed_offset:.3f}")
print(f"offset_x: {offset_x:.3f}")
print(f"offset_y: {offset_y:.3f}")

# Gripper orientation: set to angle_short so fingers are parallel to the lever long axis
grip_theta = angle_short

# ---------------------------
# Step T1: Move to high hover above handle midpoint
# ---------------------------
start_pose = make_pose(ee_x, ee_y, ee_z, ee_theta)
hover_center_pose = make_pose(handle_x, handle_y, hover_z, grip_theta)

trajectory_1 = generate_linear_trajectory(
    "T1: move to high hover above handle center",
    start_pose,
    hover_center_pose,
    num_points=15
)
execute_trajectory(trajectory_1)

# ---------------------------
# Step T2: Lateral alignment at hover height for jaw insertion
# ---------------------------
