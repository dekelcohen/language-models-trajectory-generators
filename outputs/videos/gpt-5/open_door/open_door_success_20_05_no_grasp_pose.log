# We want fingers parallel to the lever's long axis while pinching across thickness,
# so rotation must align with the short axis per the gripper orientation definition.
grip_orientation = angle_short

# Unit vectors in the XY-plane from the lever orientation angles
def unit_vec_from_angle(angle: float) -> list:
    """
    Returns a 2D unit vector [ux, uy] in the XY-plane for a given rotation angle (radians).
    The angle is measured from the +X axis, anticlockwise positive.
    """
    return [math.cos(angle), math.sin(angle)]

short_axis_uv = unit_vec_from_angle(angle_short)  # toward-door direction for the offset
long_axis_uv  = unit_vec_from_angle(angle_long)

# Small horizontal offset toward the door along the lever's short axis (thickness direction)
# Use half the thickness minus a small margin so one jaw slides into the gap.
thickness = lever_dims["length"]  # 0.032 m (short side)
offset_gap = min(thickness/2.0 - 0.004, 0.015)  # ~0.012 m target
offset_xy = [short_axis_uv[0]*offset_gap, short_axis_uv[1]*offset_gap]

# Key target poses (XY + offset, at various Z levels)
hover_above_center = [lever_pos[0], lever_pos[1], hover_z, grip_orientation]
hover_with_offset  = [lever_pos[0] + offset_xy[0], lever_pos[1] + offset_xy[1], hover_z, grip_orientation]

z_above_top = top_z + 0.010
approach_pose = [hover_with_offset[0], hover_with_offset[1], z_above_top, grip_orientation]

