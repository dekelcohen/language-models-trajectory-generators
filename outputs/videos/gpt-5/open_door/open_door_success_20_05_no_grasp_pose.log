retreat_hover = [pull_open_pose[0], pull_open_pose[1], hover_z, grip_orientation]

# Utility to generate and execute linear motion
def move_linear(desc: str, start_pose: list, end_pose: list, orientation: float, num_points: int = 20):
    """
    Generate and execute a straight-line end-effector trajectory.
    Parameters:
    - desc: short description of motion
    - start_pose: [x,y,z,theta] start
    - end_pose: [x,y,z,theta] end
    - orientation: rotation (theta) to keep during motion; must match end_pose[3]
    - num_points: number of interpolation points (>=5 recommended)
    """
    # Ensure the orientation matches the intended rotation in the end pose
    end_pose = [end_pose[0], end_pose[1], end_pose[2], orientation]
    traj = generate_linear_trajectory(desc, start_pose, end_pose, num_points=num_points)
    execute_trajectory(traj)
    return end_pose

