import math

# Environment state (given)
current_pose = [-0.3887993829569245, 0.6538050429520935, 0.9597697721155961, 0.0]

# Detected object data for the lever (from perception outputs)
lever_pos = [-0.319, -0.127, 0.638]  # midpoint of the lever
lever_dims = {"width": 0.185, "length": 0.032, "height": 0.074}
angle_short = -0.03   # orientation along shorter side (thickness direction)
angle_long  =  1.541  # orientation along longer side (lever's long axis)

# Derived geometry
top_z = lever_pos[2] + lever_dims["height"]/2.0  # top surface Z of the lever
hover_clearance = 0.25
hover_z = max(top_z + hover_clearance, current_pose[2])  # high, safe above the lever

