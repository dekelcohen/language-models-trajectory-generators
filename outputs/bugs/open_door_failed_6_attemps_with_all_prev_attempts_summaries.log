trajectory_6 = generate_linear_trajectory(
    "T6: small inward insertion at grasp height to envelop the lever",
    current_pose,
    pose(grasp_insertion_xy[0], grasp_insertion_xy[1], z_grasp, theta_grasp),
    num_points=8
)
execute_trajectory(trajectory_6)
current_pose = trajectory_6.points[-1]

# Close gripper to clamp the lever thickness
close_gripper()

# 7) Trajectory 7: Short outward seat/verify tug
trajectory_7 = generate_linear_trajectory(
    "T7: outward seat tug to verify capture",
    current_pose,
    pose(seat_tug_xy[0], seat_tug_xy[1], z_grasp, theta_grasp),
    num_points=6
)
execute_trajectory(trajectory_7)
current_pose = trajectory_7.points[-1]

# 8) Trajectory 8: Downward press to unlatch
trajectory_8 = generate_linear_trajectory(
    "T8: press lever downward to unlatch",
    current_pose,
    pose(current_pose[0], current_pose[1], z_grasp - press_down, theta_grasp),
    num_points=10
)
execute_trajectory(trajectory_8)
current_pose = trajectory_8.points[-1]

# 9) Trajectory 9: Pull phase A – outward along door normal
pullA_dx = n_out[0] * pull_A_out
pullA_dy = n_out[1] * pull_A_out
trajectory_9 = generate_linear_trajectory(
    "T9: pull phase A - 0.25 m outward along door normal",
    current_pose,
    pose(current_pose[0] + pullA_dx, current_pose[1] + pullA_dy, current_pose[2], theta_grasp),
    num_points=16
)
execute_trajectory(trajectory_9)
current_pose = trajectory_9.points[-1]

# 10) Trajectory 10: Pull phase B – outward + lateral along width
pullB_dx = n_out[0] * pull_B_out + w_dir[0] * pull_B_w
pullB_dy = n_out[1] * pull_B_out + w_dir[1] * pull_B_w
trajectory_10 = generate_linear_trajectory(
    "T10: pull phase B - add outward and -width component",
    current_pose,
    pose(current_pose[0] + pullB_dx, current_pose[1] + pullB_dy, current_pose[2], theta_grasp),
    num_points=16
)
execute_trajectory(trajectory_10)
current_pose = trajectory_10.points[-1]

# 11) Trajectory 11: Pull phase C – more outward + more lateral with small z relief
pullC_dx = n_out[0] * pull_C_out + w_dir[0] * pull_C_w
pullC_dy = n_out[1] * pull_C_out + w_dir[1] * pull_C_w
trajectory_11 = generate_linear_trajectory(
    "T11: pull phase C - more outward, more -width, with z relief",
    current_pose,
    pose(current_pose[0] + pullC_dx, current_pose[1] + pullC_dy, current_pose[2] + pull_C_z_relief, theta_grasp),
    num_points=18
)
execute_trajectory(trajectory_11)
current_pose = trajectory_11.points[-1]

# 12) Trajectory 12: Vertical retreat to high hover; open and finish
trajectory_12 = generate_linear_trajectory(
    "T12: vertical retreat to high hover for clearance",
    current_pose,
    pose(current_pose[0], current_pose[1], z_high, theta_grasp),
    num_points=10
)
execute_trajectory(trajectory_12)
current_pose = trajectory_12.points[-1]

open_gripper()
task_completed()

