<?xml version="1.0" ?>
<robot name="adroit_door">

  <!-- MATERIALS -->
  <material name="MatWood">
   <texture filename="wood.png"/>
  </material>
  <material name="MatFoil">
    <!-- Bright Silver color -->
    <color rgba="0.65 0.68 0.72 1.0"/>
  </material>
  <material name="MatSteel">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <!-- 
       ROOT LINK: WORLD 
       Used to align the door to the specific coordinates defined 
       in the original XML (pos="-0.107 0.043 0.447").
  -->
  <link name="world"/>

  <joint name="world_to_frame" type="fixed">
    <parent link="world"/>
    <child link="frame_link"/>
    <origin xyz="-0.107339 0.0435293 0.447376" rpy="0 0 0"/>
  </joint>

  <!-- LINK: DOOR FRAME -->
  <link name="frame_link">
    <inertial>
      <origin xyz="0.29 0 0" rpy="0 0 0"/>
      <mass value="7.85398"/>
      <inertia ixx="0.92" ixy="0" ixz="0" iyy="0.76" iyz="0" izz="0.16"/>
    </inertial>
    
    <!-- Right Post (Hinge Side) -->
    <!-- MJCF: pos 0.6, size 0.05 0.25 (r, h). Length/origin.z extended so the post's
         bottom edge reaches world z=0 (floor) given door_start_position=[-0.11,0.04,0.25]
         and the world_to_frame joint's z=0.447376 offset; top edge (world z=0.947376)
         is kept unchanged so the hinge/handle/latch geometry above is unaffected. -->
    <visual>
      <origin xyz="0.6 0 -0.223688" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.947376"/>
      </geometry>
      <material name="MatWood"/>
    </visual>
    <collision>
      <origin xyz="0.6 0 -0.223688" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.947376"/>
      </geometry>
    </collision>

    <!-- Left Post -->
    <!-- MJCF: pos -0.02. Extended to floor, see Right Post note above. -->
    <visual>
      <origin xyz="-0.02 0 -0.223688" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.947376"/>
      </geometry>
      <material name="MatWood"/>
    </visual>
    <collision>
      <origin xyz="-0.02 0 -0.223688" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.947376"/>
      </geometry>
    </collision>
  </link>

  <!-- JOINT: HINGE -->
  <!-- 
       Calculated Origin: 
       MJCF Door Body Pos (0.29) + Joint Pos (0.31) = 0.60 
       This places the joint axis exactly at the Right Post.
  -->
  <joint name="door_hinge" type="revolute">
    <parent link="frame_link"/>
    <child link="door_panel"/>
    <origin xyz="0.6 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.57" effort="100" velocity="10"/>
    <dynamics damping="1.0" friction="2.0"/>
  </joint>

  <!-- LINK: MOVING DOOR PANEL -->
  <link name="door_panel">
    <inertial>
      <!-- Offset inertial pos by -0.31 (dist to pivot) -->
      <!-- Original: 0.029, New: 0.029 - 0.31 = -0.281 -->
      <origin xyz="-0.281 -0.0015 0" rpy="0 0 0"/>
      <mass value="2.43"/>
      <inertia ixx="0.09" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.04"/>
    </inertial>

    <!-- Main Board -->
    <!-- Offset by -0.31 to shift body center away from pivot. Extended downward (z origin
         shifted, height grown) so the panel's bottom edge sits 0.05 m above the floor,
         given door_start_position=[-0.11,0.04,0.25]; top edge (world z=0.947376, level
         with the frame posts/hinge) kept unchanged so hinge/latch/handle geometry is
         unaffected. Rotation is about the vertical hinge axis only, so this vertical
         extension stays correct at any swing angle. -->
    <visual>
      <origin xyz="-0.31 0 -0.198688" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.1 0.897376"/> 
      </geometry>
      <material name="MatWood"/>
    </visual>
    <collision>
      <origin xyz="-0.31 0 -0.198688" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.1 0.897376"/>
      </geometry>
    </collision>

    <!-- Inner Cylinder -->
    <!-- MJCF 0.2. New: 0.2 - 0.31 = -0.11. Extended to match Main Board, see note above. -->
    <visual>
      <origin xyz="-0.11 0 -0.198688" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.897376"/>
      </geometry>
      <material name="MatWood"/>
    </visual>

    <!-- Outer Cylinder -->
    <!-- MJCF -0.2. New: -0.2 - 0.31 = -0.51. Extended to match Main Board, see note above. -->
    <visual>
      <origin xyz="-0.51 0 -0.198688" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.897376"/>
      </geometry>
      <material name="MatWood"/>
    </visual>
  </link>

  <!-- JOINT: LATCH -->
  <!-- 
       Latch is at door_body local pos -0.15.
       In URDF frame (relative to hinge at 0.31), pos is -0.15 - 0.31 = -0.46
  -->
  <joint name="latch_joint" type="revolute">
    <parent link="door_panel"/>
    <child link="latch"/>
    <origin xyz="-0.46 0 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.57" effort="50" velocity="10"/>
    <dynamics friction="5.0"/>
  </joint>

  <!-- LINK: HANDLE/LATCH -->
  <link name="latch">
    <inertial>
      <origin xyz="-0.017 0.013 0" rpy="0 0 0"/>
      <mass value="3.53"/>
      <inertia ixx="0.048" ixy="0" ixz="0" iyy="0.041" iyz="0" izz="0.011"/>
    </inertial>

    <!-- Horizontal Bar (Main Handle) -->
    <!-- Rotation X 90 degrees (1.57 rad) to align cylinder along Y -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.3"/> 
      </geometry>
      <material name="MatFoil"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.3"/> 
      </geometry>
    </collision>

    <!-- Side Cap 1 -->
    <!-- Rot Y 90 deg -->
    <visual>
      <origin xyz="0.1 -0.15 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.2"/>
      </geometry>
      <material name="MatFoil"/>
    </visual>

    <!-- Side Cap 2 -->
    <!-- Rot Y 90 deg -->
    <visual>
      <origin xyz="-0.1 0.1 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
      <material name="MatFoil"/>
    </visual>
  </link>

</robot>