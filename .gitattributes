* text=auto

# Force LF for source and config
*.py   eol=lf
*.sh   eol=lf
*.md   eol=lf
*.yml  eol=lf
*.yaml eol=lf
*.json eol=lf
*.txt  eol=lf
*.xml  eol=lf
*.cfg  eol=lf
*.ini  eol=lf
*.urdf eol=lf

# Windows scripts
*.bat  eol=crlf
*.ps1  eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.zip  binary
*.pth  binary
*.obj  binary
*.stl  binary
*.dae  binary
*.mtl  binary
